<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="mail.AttachmentList" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-mail-AttachmentCard-aside')]" position="before">
          <button t-if="isCoolAttachment(attachment)" t-on-click="() => this.coolOpen(attachment)">
            <img src="/collabora_odoo/static/description/icon.svg" aria-label="Open in Collabora Online" />
          </button>
        </xpath>
    </t>
</templates>
